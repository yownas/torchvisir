{
    "repos": {
        "NVIDIA": {
            "pattern": "^cu[0-9]+:.+",
            "index_url": "https://download.pytorch.org/whl/TARGET",
            "pkgs": [
                "torch==2.14.1+TARGET",
                "torchvision==0.29.1+TARGET",
                "torchaudio==2.11.0+TARGET"
            ]
        },
        "AMD": {
            "pattern": "^gfx[0-9]+:.+",
            "index_url": "https://stable.repo.amd.com/rocm/whl-next/",
            "pkgs": [
                "torch[device-TARGET]==2.14.0+rocm10.1.0",
                "torchvision[device-TARGET]==0.29.0a0+rocm10.1.0",
                "torchaudio==2.11.0.3+rocm10.1.0"
            ]
        },
        "INTEL": {
            "pattern": "^xpu:.+",
            "index_url": "https://download.pytorch.org/whl/xpu",
            "pkgs": [
                "torch+xpu",
                "torchvision+xpu",
                "torchaudio+xpu"
            ]
        },
        "CPU": {
            "pattern": "^cpu:.+",
            "index_url": "https://download.pytorch.org/whl",
            "pkgs": [
                "torch",
                "torchvision",
                "torchaudio"
            ]
        }
    }
}
